        <mxCell id="tab_contents_c2" value="&lt;b&gt;ISI DARI SETIAP RUANGAN — KOLEKSI &amp;amp;amp; PAMERAN&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;font-weight:normal;color:#E6C265'&gt;Daftar lengkap materi sejarah, tokoh, artefak, dan dokumen di seluruh ruangan museum&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#C9A24B;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
