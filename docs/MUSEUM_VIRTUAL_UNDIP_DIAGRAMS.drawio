        </mxCell>
        <mxCell id="tab_contents_c15" value="&lt;b&gt;Tengah: Monumen Utama Zona 2&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Monumen 'The Growth of Knowledge' sebagai simbol pertumbuhan ilmu pengetahuan dan inovasi.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9A24B;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="563" y="518" width="434" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c16" value="&lt;b&gt;Sayap Kanan: Riset Unggulan&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Pola Ilmiah Pokok (PIP) Bina Kelautan, Laboratorium Terpadu, serta capaian 500+ Hak Paten &amp;amp; hilirisasi produk.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9A24B;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="563" y="678" width="434" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c17" value="&lt;b&gt;Sayap Kanan: Prestasi &amp;amp; Pengabdian&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Program Pelopor KKN Tematik 3T (1.200+ desa binaan) serta capaian peringkat dunia QS Rankings &amp;amp; UI GreenMetric.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9A24B;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="563" y="838" width="434" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1050" y="115" width="470" height="910" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c19" value="ZONA 3: WARISAN SEJARAH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C6D2E;strokeColor=#0B1F3A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1066" y="130" width="438" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c20" value="&lt;b&gt;Plaza Pusat: Prasasti Monumental&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Prasasti batu andesit pahat emas peresmian Universitas Semarang (1957) &amp;amp; penganugerahan nama Diponegoro oleh Ir. Soekarno (1960).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="198" width="434" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c21" value="&lt;b&gt;Galeri Utara: 28 Foto Sejarah&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Kilas balik visual 1956–1995: kuliah perdana, amanat Bung Karno, KKN pertama, survei Tembalang, hingga kapal riset.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="333" width="434" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c22" value="&lt;b&gt;Sayap Barat: 12 Vitrine Artefak&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Toga Rektor, Buku Induk Angkatan I, Mikroskop Zeiss, Segel Yayasan, Mesin Tik Presidium, Globe Maritim, Ijazah Perkamen, dll.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="468" width="434" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c23" value="&lt;b&gt;Barat Daya: Hall of Legacy (8 Pilar)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;8 Tokoh kunci beserta benda memorabilia orbit: Soedarto, Imam Bardjo, Goenawan, Dan Sulaiman, Kariadi, Moeljono, Satjipto, Muladi.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="603" width="434" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c24" value="&lt;b&gt;Sayap Timur: 10 Dokumen Piagam&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Akta Notaris 1956, PP No. 7/1961, Piagam Soekarno, Masterplan Pleburan, Peta Lahan Tembalang 180 Ha, Dekrit PIP Kelautan.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="738" width="434" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_contents_c25" value="&lt;b&gt;Tenggara: Paviliun Mini-Cinema&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#334155'&gt;Layar utama film restorasi Dies Natalis 1960, 8 TV Wall arsip dokumenter, &amp;amp; 3 stasiun dengar (Gramofon, Radio RRI, Kaset Mars Undip).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1068" y="873" width="434" height="118" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab_zone1_detail" name="6. Penjabaran Zona 1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tab_zone1_detail_c2" value="&lt;b&gt;PENJABARAN DETAIL ZONA 1 — SETIAP RUANGAN BESERTA ISINYA&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;font-weight:normal;color:#E6C265'&gt;Rincian lengkap Aula Utama (Base Zone 1) dan seluruh isi koleksi pada Ruang 01 hingga Ruang 05&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#C9A24B;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="1640" height="64" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c3" value="&lt;b&gt;AULA UTAMA (BASE ZONE 1) — Ukuran 15.2m x 38.0m x Tinggi 8.8m&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Arsitektur &amp;amp; Cahaya:&lt;/b&gt; Langit-langit celah bergantian, lampu gantung chandelier, partikel debu emas (saat intro), &amp;amp; lantai marmer.&lt;br/&gt;• &lt;b&gt;Sumbu Tengah:&lt;/b&gt; Karpet Merah (lebar 3.2m), Peta Miniatur Kampus Undip, Podium Kehormatan, Prasasti Peresmian (9 Jan 1957), &amp;amp; Monumen Pangeran Diponegoro.&lt;br/&gt;• &lt;b&gt;Furnitur &amp;amp; Navigasi:&lt;/b&gt; Papan Direktori (radius deteksi 3.2m + denah formasi 3–2), Rak Buku Arsip, Meja Kaca, Kursi Santai Pengunjung, &amp;amp; 5 Pintu Portal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#C9A24B;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="108" width="1640" height="118" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c4" value="&lt;b&gt;RUANG 01: ARSIP PENDIRI &amp;amp; YAYASAN&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#8C6D2E;font-weight:bold'&gt;Posisi: Dinding Kiri 1 | Atap: Coffered Skylight | Lampu Hias Dinding&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A. 5 Tokoh Pendiri Utama (Bingkai Emas):&lt;/b&gt;&lt;br/&gt;1. Mr. Soedarto (Ketua Presidium Yayasan &amp;amp; Rektor Pembangun)&lt;br/&gt;2. Mr. Imam Bardjo (Presiden/Rektor Pertama Univ. Semarang)&lt;br/&gt;3. Mr. Goenawan Goetomo (Dekan Pertama Akad. Administrasi Negara)&lt;br/&gt;4. Mr. Tan Tjing Hak (Cendekiawan Hukum &amp;amp; Tokoh Inklusivitas)&lt;br/&gt;5. dr. Heyder bin Heyder (Direktur R.S. Semarang &amp;amp; Perintis Kedokteran)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;B. 4 Arsip Sejarah Awal:&lt;/b&gt;&lt;br/&gt;6. Akta Pendirian Yayasan No. 59 Tahun 1956&lt;br/&gt;7. Naskah Statuta &amp;amp; Kurikulum Perdana (1957)&lt;br/&gt;8. Foto Perkuliahan Awal di Gedung Panti Budaya (1957–1966)&lt;br/&gt;9. Foto Angkatan Pertama Mahasiswa Undip (1957)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#1E3A5F;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="270" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c5" value="&lt;b&gt;RUANG 02: PENEGERIAN &amp;amp; PIDATO SOEKARNO&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#8C6D2E;font-weight:bold'&gt;Posisi: Dinding Kiri 2 | Atap: Labyrinth PVC | Lampu Hias Dinding&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Isi 5 Koleksi Sejarah Penegerian:&lt;/b&gt;&lt;br/&gt;1. Lukisan Induk: Api Perjuangan Pangeran Diponegoro (1825–1830)&lt;br/&gt;&lt;br/&gt;2. Peraturan Pemerintah No. 7 Tahun 1961 (Penegerian Undip)&lt;br/&gt;&lt;br/&gt;3. Salinan Lembaran Berita Negara Penegerian Undip&lt;br/&gt;&lt;br/&gt;4. Arsip Pidato Presiden Soekarno (9 Januari 1960)&lt;br/&gt;&lt;br/&gt;5. Dokumentasi Kunjungan Bung Karno pada Dies Natalis III" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#1E3A5F;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="270" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c6" value="&lt;b&gt;RUANG 03: GALERI REKTORAT &amp;amp; PIMPINAN&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#8C6D2E;font-weight:bold'&gt;Posisi: Dinding Kiri 3 | Atap: Octagon Dome | Lampu Hias Dinding&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Isi 13 Potret &amp;amp; Biografi Pimpinan / Rektor Undip:&lt;/b&gt;&lt;br/&gt;1. Prof. Mr. Imam Bardjo (1957–1961)&lt;br/&gt;2. Prof. Mr. Soedarto, S.H. (1961–1962 &amp;amp; 1977–1986)&lt;br/&gt;3. Prof. Dr. Ir. Jakub Rais, M.Sc. (Caretaker 1965–1966)&lt;br/&gt;4. Mochtar (Gubernur Jateng 1960–1966 • Dewan Pembina)&lt;br/&gt;5. Prof. Mr. Sunario Sastrowardoyo (1973–1977)&lt;br/&gt;6. Prof. Dr. dr. A. Suroyo (1977–1986)&lt;br/&gt;7. Prof. Dr. dr. R. Moeljono S. Trastotenojo (1986–1994)&lt;br/&gt;8. Prof. Dr. Muladi, S.H. (1994–1998)&lt;br/&gt;9. Prof. Ir. Eko Budihardjo, M.Sc. (1998–2006)&lt;br/&gt;10. Prof. Dr. dr. Susilo Wibowo, M.S., Sp.And. (2006–2010)&lt;br/&gt;11. Prof. Dr. Sudharto P. Hadi, MES, Ph.D. (2010–2014)&lt;br/&gt;12. Prof. Dr. Yos Johan Utama, S.H., M.Hum. (2015–2024)&lt;br/&gt;13. Prof. Dr. Suharnomo, S.E., M.Si. (2024–sekarang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFBF7;strokeColor=#1E3A5F;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="270" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c7" value="&lt;b&gt;RUANG 04: TRANSFORMASI KAMPUS FISIK&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#8C6D2E;font-weight:bold'&gt;Posisi: Dinding Kanan 1 | Atap: Coffered PVC | Lampu Hias Dinding&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Isi 6 Koleksi Pembangunan &amp;amp; Infrastruktur Kampus:&lt;/b&gt;&lt;br/&gt;1. Foto Kampus Pleburan &amp;amp; Gedung Rektorat (1969–1985)&lt;br/&gt;2. Masterplan &amp;amp; Pembangunan Kampus Tembalang (1985–1990)&lt;br/&gt;3. Foto Peletakan Batu Pertama Kampus Tembalang (1987)&lt;br/&gt;4. Foto Pembangunan Menara Rektorat Widya Puraya (1993)&lt;br/&gt;5. Rumah Sakit Nasional Diponegoro (RSND) &amp;amp; FK Tembalang&lt;br/&gt;6. Waduk Pendidikan Undip &amp;amp; Sabuk Hijau Konservasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9A24B;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="710" width="520" height="340" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c8" value="&lt;b&gt;RUANG 05: CETAK BIRU MULADI DOME&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#8C6D2E;font-weight:bold'&gt;Posisi: Dinding Kanan 2 | Atap: Radial Dome | Lampu Hias Dinding&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Isi 3 Koleksi Ikon &amp;amp; Transformasi Modern:&lt;/b&gt;&lt;br/&gt;1. Gedung Muladi Dome: Mahakarya Convention &amp;amp; Expo Hall&lt;br/&gt;&lt;br/&gt;2. Foto Wisuda Sarjana Perdana Universitas Diponegoro (1962)&lt;br/&gt;&lt;br/&gt;3. Transformasi Menuju PTN-BH &amp;amp; World Class University" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#C9A24B;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="710" width="520" height="340" as="geometry" />
        </mxCell>
        <mxCell id="tab_zone1_detail_c9" value="&lt;b&gt;FASILITAS &amp;amp; MEKANISME DI SETIAP SUB-RUANGAN&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#1E3A5F;font-weight:bold'&gt;Berlaku Konsisten pada Ruang 01 hingga Ruang 05&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Dimensi Otomatis:&lt;/b&gt; Panjang (minimal 15m) &amp;amp; lebar ruang (10.8m–13.6m) menyesuaikan jumlah koleksi di dalamnya.&lt;br/&gt;• &lt;b&gt;Pencahayaan Khusus:&lt;/b&gt; Setiap bingkai dilengkapi lampu hias dinding emas &amp;amp; sorot cahaya hangat.&lt;br/&gt;• &lt;b&gt;Interaksi Pameran:&lt;/b&gt; Arahkan kursor untuk sorot emas + klik untuk membuka Panel Informasi 2 Kolom (Gambar Tetap + Teks Gulir).&lt;br/&gt;• &lt;b&gt;Navigasi Keluar:&lt;/b&gt; Tersedia pintu keluar di belakang ruangan serta tombol kapsul '← Kembali ke Base Zone' di atas tengah layar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#1E3A5F;strokeWidth=2;fontColor=#0B1F3A;fontSize=12;fontStyle=0;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="710" width="520" height="340" as="geometry" />
        </mxCell>
