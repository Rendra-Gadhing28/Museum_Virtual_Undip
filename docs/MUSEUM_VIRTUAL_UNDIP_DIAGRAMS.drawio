        <mxCell id="tab_zone1_detail_c14" value="Portal Kanan 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C6D2E;strokeWidth=2;fontColor=#0B1F3A;fontSize=11;fontStyle=1;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="tab_zone1_detail_c5" target="tab_zone1_detail_c8">
